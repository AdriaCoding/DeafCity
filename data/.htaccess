# data/ is the Studio's private working tree: the full catalog (including
# videos not yet visible on the site), caption files, translation drafts,
# operational logs and Studio configuration. None of it is public.
#
# Subtitles reach the browser only through captions-static.php, which
# allowlists filenames and serves them from disk.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# Two exceptions: the About page's sign-language map fetches these directly
# from the browser (see js/sign_language_map.js). Both are public
# reference data — language polygons and edition city markers.
<FilesMatch "^(languages|deafcity)\.json$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Allow from all
    </IfModule>
</FilesMatch>
