    "about.block.silent_eloquence.p1": {
        "section": "about",
        "context": "About paragraph",
        "translations": {
            "en": "By blending humor, art, and activism, DEAF.city makes Deaf culture visible, fosters understanding, and builds bridges between Deaf and hearing communities worldwide.",
            "fr": "En mêlant humour, art et activisme, DEAF.city rend la culture sourde visible, favorise la compréhension et tisse des liens entre les communautés sourdes et entendantes du monde entier.",
            "ca": "Barrejant humor, art i activisme, DEAF.city fa visible la cultura Sorda, fomenta la comprensió i construeix ponts entre les comunitats Sordes i oients d'arreu del món.",
            "es": "Al combinar humor, arte y activismo, DEAF.city visibiliza la cultura Sorda, fomenta la comprensión y construye puentes entre las comunidades Sordas y oyentes de todo el mundo."
        },
        "seeded": {
            "fr": true,
            "ca": true,
            "es": true
        }
    },
